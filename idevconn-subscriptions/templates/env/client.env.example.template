# ─────────────────────────────────────────────────────────────────────────────
# Subscription Environment Variables (Client / Vite / React)
# Copy relevant entries into your apps/client/.env.example and fill real values
# in your apps/client/.env (never commit real values to git).
#
# These vars are baked into the browser bundle at build time (VITE_ prefix).
# Do NOT put server-only secrets here (e.g. PAYPAL_SECRET, ISUBSCRIBE_API_KEY
# server key — use the public key instead for VITE_TENANT_KEY).
# ─────────────────────────────────────────────────────────────────────────────

# ── iSubscribe widget ─────────────────────────────────────────────────────────

# Base URL for the SubscriptionWidget component to fetch plans.
# The widget appends /public/subscriptions to this URL.
# Default for the iSubscribe SaaS hosted service.
VITE_SUBSCRIBE_BASE_URL=https://isubscribe.me/api/v1

# Client-safe (public) tenant key for the SubscriptionWidget.
# This is exposed in the browser bundle — it is a read-only public key.
# Obtain from: iSubscribe dashboard → Tenant → Public Key (or API Key if there
# is only one key — verify with your iSubscribe dashboard which key is public-safe).
VITE_TENANT_KEY=pk_live_REPLACE_ME
