# ─────────────────────────────────────────────────────────────────────────────
# Subscription & Payment Environment Variables (API / NestJS)
# Copy relevant entries into your apps/api/.env.example and fill real values
# in your apps/api/.env (never commit real values to git).
# ─────────────────────────────────────────────────────────────────────────────

# ── iSubscribe (plan catalog) ─────────────────────────────────────────────────

# Server-to-server API endpoint for fetching the subscription plan catalog.
# Default for the iSubscribe SaaS hosted service.
ISUBSCRIBE_API_URL=https://isubscribe.me/api/v1/public/subscriptions/data

# Server-side API key for authenticating with iSubscribe.
# Obtain from: iSubscribe dashboard → Tenant → API Key
ISUBSCRIBE_API_KEY=sk_live_REPLACE_ME

# The Origin header sent with server-side catalog requests.
# Must match an allowed origin in your iSubscribe dashboard settings.
# For development use http://localhost:5173 (or your Vite dev server port).
ISUBSCRIBE_ORIGIN=https://your-app.com

# ── Free plan ─────────────────────────────────────────────────────────────────

# The iSubscribe plan ID of the free Starter plan.
# Auto-assigned to every new user on registration.
# Obtain from: iSubscribe dashboard → Plans → click Starter plan → copy ID
FREE_SUBSCRIPTION_PLAN_ID=REPLACE_ME_WITH_STARTER_PLAN_ID

# ── PayPal ───────────────────────────────────────────────────────────────────

# PayPal OAuth app credentials.
# Obtain from: https://developer.paypal.com → My Apps & Credentials → your app
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_SECRET=REPLACE_ME

# PayPal environment. Use "sandbox" for development, "live" for production.
# The @idevconn/payment PaypalStrategy routes to the correct endpoint automatically.
PAYPAL_ENV=sandbox

# ── App base URL ─────────────────────────────────────────────────────────────

# The public base URL of your client application.
# Used to build PayPal return_url (/subscriptions/success) and
# cancel_url (/subscriptions/cancel) in createPaidOrder.
# For local development: http://localhost:4200 (or your client dev server port).
APP_BASE_URL=http://localhost:4200
