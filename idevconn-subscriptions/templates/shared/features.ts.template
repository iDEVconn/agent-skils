 */
export const FEATURE_SLUGS = {
  // ── Free / Starter tier ─────────────────────────────────────────────────
  // PLACEHOLDER: Replace VALUES with your Starter-tier slugs from iSubscribe.
  // Key names below are referenced by service code — see header note.
  MAX_ITEMS: "up_to_10_items",                  // numeric cap (used by service)
  BASIC_FEATURE: "basic_feature",               // example boolean feature
  STORAGE_MB: "storage_100_mb",                 // numeric storage cap (used by service)

  // ── Paid tier (Pro / Premium) ────────────────────────────────────────────
  // PLACEHOLDER: Replace VALUES with your paid-tier slugs.
  UNLIMITED_ITEMS: "unlimited_items",           // used by service (UNLIMITED_ITEMS → MAX_ITEMS = null)
  STORAGE_GB: "storage_5_gb",                   // larger cap, normalized into STORAGE_MB by service
  PREMIUM_FEATURE: "premium_feature",           // example boolean feature

  // ── Add more features as needed ──────────────────────────────────────────
