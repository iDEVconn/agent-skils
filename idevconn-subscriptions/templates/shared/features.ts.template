 *   number = numeric cap (e.g. 10 = up to 10 items; larger = more access)
 *   null   = unlimited (use this for UNLIMITED_* slugs)
 *
 * The iSubscribe dashboard controls WHICH features each plan has.
 * This map controls WHAT each feature means in your app.
 */
export const FEATURE_VALUES: Record<FeatureSlug, FeatureValue> = {
  // PLACEHOLDER: Replace all values with semantics appropriate for your product.
  [FEATURE_SLUGS.MAX_ITEMS]: 10,
  [FEATURE_SLUGS.BASIC_FEATURE]: true,
  [FEATURE_SLUGS.STORAGE_MB]: 100,
  [FEATURE_SLUGS.UNLIMITED_ITEMS]: true,  // true here; normalized to null in buildEntitlementsFromPlan
  [FEATURE_SLUGS.STORAGE_GB]: 5120,       // 5 GB expressed in MB so STORAGE_MB normalization works
  [FEATURE_SLUGS.PREMIUM_FEATURE]: true,
