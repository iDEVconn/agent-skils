import { Injectable, Logger, OnApplicationBootstrap } from "@nestjs/common";
import { FEATURE_SLUGS } from "@warranty/shared /* PLACEHOLDER: replace with your shared lib alias */";
import { ISubscribeService } from "./isubscribe.service";

@Injectable()
export class FeatureSlugValidator implements OnApplicationBootstrap {
  private readonly logger = new Logger(FeatureSlugValidator.name);

  constructor(private readonly isubscribe: ISubscribeService) {}

  async onApplicationBootstrap() {
    let plans;
    try {
      plans = await this.isubscribe.getPlans();
    } catch (err) {
      // Upstream unreachable / misconfigured at bootstrap — surface a warning but
      // don't block the API from starting. Slug drift can still be detected later
      // once the upstream recovers and the first plan fetch lands. Keeping the
      // validator non-fatal is consistent with the broader graceful-startup story:
      // we never want a missing iSubscription env var to take the whole API down.
      const message = err instanceof Error ? err.message : String(err);
      this.logger.warn(
        `Skipping feature slug validation — iSubscription upstream unavailable (${message})`,
      );
      return;
    }
    const apiSlugs = new Set<string>();
    for (const plan of plans) {
      for (const f of plan.features) {
        if (f.slug) apiSlugs.add(f.slug);
      }
    }
    const declared = Object.values(FEATURE_SLUGS);
    const missing = declared.filter((s) => !apiSlugs.has(s));
    if (missing.length > 0) {
      // Drift is usually intentional (admin hid a feature in the dashboard
      // because it's not yet ready) — never fail the boot on it. Gates that
      // reference a missing slug will simply never be granted, which is the
      // safe outcome: hiding a feature in the dashboard also disables its
      // entitlement everywhere.
      this.logger.warn(
        `FEATURE_SLUGS contains slugs not present in iSubscription API: ${missing.join(", ")}. ` +
          "Gates for these slugs will return false until the dashboard exposes them again " +
          "or libs/shared/src/features.ts is updated.",
      );
      return;
    }
    this.logger.log(`Feature slug validation OK (${declared.length} slugs).`);
  }
}
