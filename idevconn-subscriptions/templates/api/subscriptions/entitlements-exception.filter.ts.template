import { ArgumentsHost, Catch, ExceptionFilter, Logger } from "@nestjs/common";
import type { Response } from "express";
import { EntitlementsError } from "@idevconn/isubscribe-entitlements";

/**
 * Strips PII fields (`userId`, `tenantId`) from entitlements pkg error responses
 * in production. In dev/test, leaves all fields for debugging.
 *
 * Audit L2: pkg's default error body includes user identifiers, which leak
 * internal IDs and tenant naming conventions to the client.
 *
 * Note: the pkg uses `statusCode` (not `status`) for the HTTP code.
 * See: @idevconn/isubscribe-entitlements/dist/index.d.ts — EntitlementsError.statusCode
 */
@Catch(EntitlementsError)
export class EntitlementsExceptionFilter implements ExceptionFilter {
  private readonly logger = new Logger(EntitlementsExceptionFilter.name);
  private readonly isProduction = process.env.NODE_ENV === "production";

  catch(exception: EntitlementsError, host: ArgumentsHost): void {
    const ctx = host.switchToHttp();
    const response = ctx.getResponse<Response>();

    // pkg uses `statusCode` (not `status`) — default to 500 if somehow missing
    const httpStatus = exception.statusCode ?? 500;

    const fullBody: Record<string, unknown> =
      typeof exception.toResponseBody === "function"
        ? exception.toResponseBody()
        : { code: exception.code, message: exception.message };

    // Log the full body server-side (all detail preserved) before stripping PII
    this.logger.warn(`Entitlements error ${exception.code}: ${JSON.stringify(fullBody)}`);

    const safeBody = this.isProduction
      ? {
          ...fullBody,
          details:
            fullBody.details != null
              ? this.stripPiiFromDetails(fullBody.details as Record<string, unknown>)
              : undefined,
        }
      : fullBody;

    // Remove the `details` key entirely when undefined (cleaner response body)
    if (safeBody.details === undefined) {
      delete safeBody.details;
    }

    response.status(httpStatus).json(safeBody);
  }

  private stripPiiFromDetails(details: Record<string, unknown>): Record<string, unknown> {
    // eslint-disable-next-line @typescript-eslint/no-unused-vars
    const { userId, tenantId, ...rest } = details;
    return rest;
  }
}
